# Current configuration is read from process environment, NOT automatically from .env.
# Daily operation uses Sepolia: .env.sepolia.example -> .env.sepolia, then npm start.
# These legacy local values are only for isolated development/tests: npm run start:local.
DEMO_MODE=0
LOCAL_RPC_URL=http://127.0.0.1:8545
# Local listener: read-only scanning, no transaction fee. start:local starts/reuses it.
FORGE_INDEX_BATCH=500
FORGE_INDEX_INTERVAL=5
# UI: http://127.0.0.1:5173
# API: http://127.0.0.1:8000
# State and auto-generated mint signing key: .local/ (ignored by Git)
# Balance parameters: backend/balance.json
# No private keys or seed phrases belong in this template.
# Sepolia preparation uses .env.sepolia.example -> .env.sepolia and npm run check:sepolia.
# npm run backend:sepolia loads that file into a separate .local/sepolia/ backend.
# It does not deploy contracts. npm start runs the Sepolia game.
