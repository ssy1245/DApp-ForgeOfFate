# Sepolia 开发准备配置。复制到根目录 .env.sepolia 后填写。
# 本模板随源码提交 GitHub，真实地址与 API 密钥只填写在 .env.sepolia。
# 由 npm start、npm run deploy:console、check:sepolia、backend:sepolia、indexer:sepolia 读取。
# 所有正常启动入口使用 Sepolia；后端存档和部署工作台记录保存在独立 .local/sepolia/。
# 这里只填写地址和运行参数，不填写钱包私钥、助记词或钱包密码。
# NFT 图片共用 assets/NFT_Pic/manifest.json 中的固定公开链接，无需在此填写图片地址或 GitHub 凭据。
# 图片公开访问核验和映射接入进度见 assets/NFT_Pic/README.md。
# 当前部署工作台仅提供验证合约；NFT 业务、充值和质押尚未完成 Sepolia 部署。

# 必填：MetaMask 中复制的项目钱包公开地址，以 0x 开头。
# 已确定：这个钱包同时用于部署合约和接收项目充值收入，只需填一次。
# npm run deploy:console 要求 MetaMask 使用此地址，部署手续费消耗该钱包的 Sepolia 测试 ETH。
PROJECT_WALLET_ADDRESS=

# 必填：RPC 服务商提供的 Ethereum Sepolia HTTP(S) 连接地址。
# 填完整 URL，不要只填 API 密钥。Infura 格式：https://sepolia.infura.io/v3/<你的API密钥>
# 可能包含服务商 API 密钥，只放在 .env.sepolia，不上传 Git 或粘贴到聊天。
SEPOLIA_RPC_URL=

# 可选：用于双钱包购买测试的第二个钱包公开地址，与项目钱包不同。
# 现在没有可以先留空，实际演示前再准备。
DEMO_BUYER_ADDRESS=

# 可选：监听每批区块数（1–2000）；服务商限制范围时自动缩小，不跳过失败区间。
FORGE_INDEX_BATCH=500

# 可选：追上当前确认边界后，两次检查间隔秒数（1–30）。
FORGE_INDEX_INTERVAL=5
# Sepolia 固定等待 finalized 边界；节点不支持时停止推进，不降级为 latest。
# 当前监听仅保存 NFT 事件和索引；充值、质押和发币尚未实现。
