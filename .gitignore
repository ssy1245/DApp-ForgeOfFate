# Test and browser output
# Includes screenshots, videos, traces and failure-state attachments.
playwright-report/
test-results/
blob-report/
# npm test writes under .local/test-runs/. Also exclude root-level report copies.
/test-runs/
/results.json
/verification.json
# Browser sign-in state and local profiles must not accompany source submissions.
.auth/
browser-profiles/
storage-state*.json
storageState*.json
# Root-level manual network/trace exports; public assets remain versioned.
/*.har
/trace*.zip
# Local UI captures kept outside .local; weapon reference images stay tracked.
/screenshots/
/previews/
# Manual forge-screen/route UI captures; source textures and game art stay tracked.
/forge-monitor-*.png
/weapon-routes-*.png
# Manual copies of recharge / admin UI test captures, not game artwork.
/recharge-admins-*.png
/recharge-treasury-*.png
/recharge-desktop.png
/recharge-mobile.png
/*-preview.png
/*-preview.jpg
/*-preview.jpeg
/*-preview.webp

# Runtime data, local credentials, deployment state and logs
# Covers live saves, test-runs/, browser-tests-* / verify-game-* runs and backups.
.local/
# Known local credentials and manually suffixed copies, in any directory.
test-accounts.md
test-accounts.md.*
mint-key
mint-key.*
quote-key
quote-key.*
# Local deployment and cleanup exports, if copied into the project root.
/deployment.json
/staking-deployment.json
/recharge-deployment.json
# Additional local copies; reviewed manifests under deployments/ remain tracked.
/staking-deployment-*.json
/recharge-deployment-*.json
/local-deployment-*.json
/sepolia-deployment-*.json
# Console runtime/build exports: originals live under .local/sepolia/.
# Only ignore root-level copies; keep source manifests and empty templates.
# Public reviewed manifests under deployments/ are intentionally versioned.
/deploy-console/
# Archived unsigned deployment plans remain private when copied out of .local/.
/deploy-console-archive/
/plan.json
/state.json
/build-info.json
/nft-inventory.json
/staking-inventory.json
/cleanup-summary.json
# Interrupted atomic writes, if runtime files were placed in the project root.
/deployment.json*.tmp
/staking-deployment.json*.tmp
/recharge-deployment.json*.tmp
/plan.json*.tmp
/state.json*.tmp
/build-info.json*.tmp
backend/data/
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.sqlite.backup*
*.sqlite3.backup*
*.db
*.db-*
*.db.backup*
*.log
*.pid
*.pid.lock
*.prof
*.lprof

# Local backups / exports / scratch data (keep source migrations and assets)
/backups/
/database-backups/
/tmp/
/temp/
*.bak
*.orig
*.rej

# Keep source, README files, dependency locks and empty .env*.example templates.
# Keep chain/contracts/, chain/client/, chain/server/, chain/test/, chain/tests/
# and chain/scripts/; only their generated output is ignored by the rules above.
# Keep docs/ and chain/ testing summaries / plans; raw test reports stay local.
# Keep assets/stories/**/*.md, assets/3d/**/*.glb and assets/reference_page/**/*.png.
# Keep assets/display/ transparent PNGs, manifest.json and README.md, plus item icons.
# NFT artwork is a project source asset and should be included in GitHub submissions.
# Image exceptions leave secret-file exclusions intact; manifest.json is public source.
!/assets/NFT_Pic/**/*.png
!/assets/NFT_Pic/**/*.jpg
!/assets/NFT_Pic/**/*.jpeg
!/assets/NFT_Pic/**/*.webp
# Never ignore all *.json, *.sql, *.png or *.glb: these can be project sources.
