/screenshots/
/previews/
/*-preview.png
/*-preview.jpg
/*-preview.jpeg
/*-preview.webp

# Runtime data, local credentials, deployment state and logs
# Covers live saves, isolated browser-tests-* / verify-game-* runs and backups.
.local/
