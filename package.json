{
  "name": "forge-of-fate",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "chain"
  ],
  "scripts": {
    "indexer": "node chain/scripts/indexer-sepolia.cjs",
    "indexer:sepolia": "node chain/scripts/indexer-sepolia.cjs",
    "chain:record": ".venv/bin/python -m chain.server.indexer --record-deployment",
    "dev": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "chain": "node chain/scripts/check-sepolia.cjs",
    "deploy": "node chain/scripts/deploy-console.cjs",
    "test:contracts": "npm test -w chain",
    "test:backend": ".venv/bin/python -m pytest backend/tests chain/tests -q",
    "verify:game": "node chain/scripts/verify-game.cjs",
    "backend": "node scripts/backend-sepolia.cjs",
    "demo": "node scripts/start.cjs --demo",
    "start": "node scripts/start.cjs",
    "start:demo": "node scripts/start.cjs --demo",
    "check:sepolia": "node chain/scripts/check-sepolia.cjs",
    "accounts:setup": ".venv/bin/python scripts/create_dev_accounts.py --network sepolia",
    "backend:sepolia": "node scripts/backend-sepolia.cjs",
    "test:browser": "playwright test",
    "test:browser:report": "playwright show-report",
    "deploy:console": "node chain/scripts/deploy-console.cjs",
    "test:deploy": "playwright test chain/tests/browser/deployment.spec.cjs",
    "deploy:local": "npm run deploy -w chain",
    "start:local": "node scripts/start-local.cjs",
    "backend:local": ".venv/bin/python -m uvicorn backend.app:app --host 127.0.0.1 --port 8000 --reload --reload-dir backend --reload-dir chain/server --reload-dir assets/3d --reload-include balance.json --reload-include sword-tiers.json --reload-include sword-branches.json",
    "indexer:local": ".venv/bin/python -m chain.server.indexer",
    "accounts:setup:local": ".venv/bin/python scripts/create_dev_accounts.py",
    "test:deploy:service": "npm run compile -w chain && node --test chain/tests/deployment-service.test.cjs",
    "chain:local": "npm run node -w chain",
    "demo:local": "node chain/scripts/demo.cjs",
    "test": "node scripts/test-all.cjs",
    "test:client": "node --test chain/tests/transactions.test.mjs",
    "test:staking": "npm run compile -w chain && node chain/scripts/staking-rehearsal.cjs",
    "deploy:staking": "node chain/scripts/deploy-console.cjs --module forge-staking",
    "deploy:recharge": "node chain/scripts/deploy-console.cjs --module forge-recharge",
    "test:recharge": "npm run compile -w chain && node chain/scripts/recharge-rehearsal.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
